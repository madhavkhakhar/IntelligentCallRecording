        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000"
            android:paddingTop="3dp"/>

        <RelativeLayout
            android:id="@+id/call_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/call"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:background="@android:color/white"
                android:src="@mipmap/call" />

            <TextView
                android:id="@+id/txt_call"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="600dp"
                android:layout_marginTop="20dp"
                android:layout_toEndOf="@id/call"
                android:text="@string/call_history"
                android:textColor="#000000"
                android:textSize="30sp" />

            <EditText
                android:id="@+id/Search_list"
                android:layout_width="380dp"
                android:layout_height="50dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/edittextborder"
                android:hint="Search"
                android:paddingStart="60dp"
                android:textSize="25sp" />

            <ImageView
                android:id="@+id/search_image"
                android:layout_width="40dp"
                android:layout_height="50dp"
                android:layout_alignParentEnd="true"
                android:layout_marginRight="350dp"
                android:layout_marginTop="20dp"
                android:src="@android:drawable/ic_menu_search" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.9"
                android:background="@drawable/textviewborder"
                android:gravity="center"
                android:padding="@dimen/item_padding"
                android:text="@string/name"
                android:textColor="#000000"
                android:textSize="30sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/textviewborder"
                android:gravity="center"
                android:padding="@dimen/item_padding"
                android:text="@string/lineno"
                android:textColor="#000000"
                android:textSize="30sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:background="@drawable/textviewborder"
                android:gravity="center"
                android:padding="@dimen/item_padding"
                android:text="@string/datetime"
                android:textColor="#000000"
                android:textSize="30sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/textviewborder"
                android:gravity="center"
                android:padding="@dimen/item_padding"
                android:text="@string/number"
                android:textColor="#000000"
                android:textSize="30sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/textviewborder"
                android:padding="@dimen/item_padding"
                android:text="@string/duration"
                android:textColor="#000000"
                android:textSize="30sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.9"
                android:background="@drawable/textviewborder"
                android:gravity="center"
                android:padding="@dimen/item_padding"
                android:text="@string/staff"
                android:textColor="#000000"
                android:textSize="30sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/textviewborder"
                android:gravity="center"
                android:padding="@dimen/item_padding"
                android:text="@string/important"
                android:textColor="#000000"
                android:textSize="30sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/textviewborder"
                android:gravity="center"
                android:padding="@dimen/item_padding"
                android:text="@string/comment"
                android:textColor="#000000"
                android:textSize="30sp" />
        </LinearLayout>

        <!-- <ListView
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:id="@+id/historyList"
             >
         </ListView>
     -->
        <com.nolostcalls.intelligentcallrecording.Expandable_listView.ActionSlideExpandableListView
            android:id="@+id/historyList"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />

    </LinearLayout>


</ScrollView>