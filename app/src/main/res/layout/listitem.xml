<?xml version="1.0" encoding="utf-8"?>

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="0.9"
                android:background="@drawable/edittextborder"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:id="@+id/HistoryName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name"
                    android:textColor="#9CCC65"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/HistoryDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="22:30"
                    android:textColor="#9CCC65"
                    android:textSize="20sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1"
                android:background="@drawable/edittextborder"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/HistoryLineNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="15dp"
                    android:paddingBottom="15dp"
                    android:paddingTop="20dp"
                    android:text="1"
                    android:textColor="#9CCC65"
                    android:textSize="20sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1.3"
                android:background="@drawable/edittextborder"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:id="@+id/HistoryDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wed. 01/08/2015"
                    android:textColor="#9CCC65"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/HistoryTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="4:50 PM"
                    android:textColor="#9CCC65"
                    android:textSize="20sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1"
                android:background="@drawable/edittextborder"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:id="@+id/HistoryPhoneNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+91 1234567890"
                    android:textColor="#9CCC65"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/HistoryPhoneImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="5dp"
                        android:src="@mipmap/call_arrive" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text=" 00:10"
                        android:textColor="#9CCC65" />
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1"
                android:background="@drawable/edittextborder"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:id="@+id/DurationStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:22:12 pm"
                    android:textColor="#9CCC65"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/DurationEnd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="00:23:12 pm"
                    android:textColor="#9CCC65"
                    android:textSize="17sp" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="0.9"
                android:background="@drawable/edittextborder"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:id="@+id/HistoryStaffName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:paddingBottom="15dp"
                    android:paddingTop="20dp"
                    android:text="Jane"
                    android:textColor="#9CCC65"
                    android:textSize="20sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1"
                android:background="@drawable/edittextborder"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="15dp">

                <ImageButton
                    android:id="@+id/expandable_toggle_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:clickable="false"
                    android:focusable="false"
                    android:src="@mipmap/important" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1"
                android:background="@drawable/edittextborder"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="15dp">

                <ImageButton
                    android:id="@+id/HistoryCommentsBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="15dp"
                    android:layout_marginTop="15dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:background="@android:color/white"
                    android:src="@mipmap/chat"

                    />
            </LinearLayout>

        </LinearLayout>


